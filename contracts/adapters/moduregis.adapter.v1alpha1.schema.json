{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axisrobo.com/moduregis.adapter.v1alpha1.schema.json",
  "title": "Moduregis Adapter Manifest v1alpha1",
  "description": "Strict descriptive manifest for an AxisRobo or third-party adapter. It contains no credentials or authorization artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "id", "adapter_kind", "vendor", "version", "contract_version", "supported_capability_types"],
  "properties": {
    "api_version": { "const": "moduregis.io/v1alpha1" },
    "kind": { "const": "Adapter" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "adapter_kind": {
      "enum": ["authorization", "planning", "execution", "workflow", "memory", "coordination", "gateway", "attestation"]
    },
    "vendor": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "contract_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "endpoint_ref": {
      "type": "string",
      "format": "uri",
      "description": "Deployment-bound endpoint reference. Credentials are never present in this manifest."
    },
    "supported_capability_types": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "minItems": 1,
      "uniqueItems": true
    },
    "conformance_profiles": {
      "type": "array",
      "items": { "enum": ["CAP-C0", "CAP-C1", "CAP-C2", "CAP-C3", "CAP-C4"] },
      "uniqueItems": true
    }
  }
}
