{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axisrobo.com/moduregis.publication.v1alpha1.schema.json",
  "title": "Moduregis Publication Request v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "actor_id", "trace_id", "audit_event_id"],
  "properties": {
    "api_version": { "const": "moduregis.io/v1alpha1" },
    "kind": { "const": "PublicationRequest" },
    "actor_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "audit_event_id": { "type": "string", "minLength": 1 }
  }
}
